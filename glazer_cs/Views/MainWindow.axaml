<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GlazerAdmin.ViewModels"
        xmlns:svc="using:GlazerAdmin.Services"
        xmlns:conv="using:GlazerAdmin.Converters"
        xmlns:ctrl="using:GlazerAdmin.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="GlazerAdmin.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Glazer Admin"
        Width="1200" Height="700">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <conv:StringEqualsConverter x:Key="StringEquals" />
        <conv:IntEqualsConverter x:Key="IntEquals" />
    </Window.Resources>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenFilesCommand}" />
    </Window.KeyBindings>

    <DockPanel>

        <!-- ===================== Menu bar ===================== -->
        <DockPanel DockPanel.Dock="Top" Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">

            <!-- Language menu, right-aligned -->
            <Menu DockPanel.Dock="Right">
                <MenuItem Header="{svc:Localize filebar.language}">
                    <MenuItem Header="日本語"
                              Command="{Binding SetLanguageCommand}"
                              CommandParameter="ja" />
                    <MenuItem Header="English"
                              Command="{Binding SetLanguageCommand}"
                              CommandParameter="en" />
                </MenuItem>
            </Menu>

            <Menu>
                <!-- File -->
                <MenuItem Header="{svc:Localize filebar.file}">
                    <MenuItem Header="{svc:Localize filebar.open}"
                              Command="{Binding OpenFilesCommand}"
                              InputGesture="Ctrl+O" />
                    <MenuItem Header="{svc:Localize filebar.openFolder}"
                              Command="{Binding OpenFolderCommand}" />
                    <Separator />
                    <MenuItem Header="{svc:Localize filebar.closeFile}"
                              Command="{Binding CloseCurrentFileCommand}" />
                    <MenuItem Header="{svc:Localize filebar.clearFiles}"
                              Command="{Binding ClearAllFilesCommand}" />
                    <Separator />
                    <MenuItem Header="{svc:Localize filebar.export}">
                        <MenuItem Header="{svc:Localize filebar.exportAll}"
                                  Command="{Binding ExportAllCommand}" />
                        <MenuItem Header="{svc:Localize filebar.exportCurr}"
                                  Command="{Binding ExportCurrentCommand}" />
                    </MenuItem>
                </MenuItem>

                <!-- Models -->
                <MenuItem Header="{svc:Localize filebar.models}">
                    <MenuItem Header="tile_detector" IsEnabled="False" />
                    <Separator />
                    <MenuItem Header="{svc:Localize filebar.uploadModel}"
                              Command="{Binding UploadModelCommand}" />
                </MenuItem>

                <!-- Help -->
                <MenuItem Header="{svc:Localize filebar.help}">
                    <MenuItem Header="{svc:Localize filebar.about}" Click="OnAboutClick" />
                    <MenuItem Header="{svc:Localize filebar.instructions}" Click="OnInstructionsClick" />
                </MenuItem>

                <!-- Preprocess action -->
                <MenuItem Header="{svc:Localize filebar.preprocess}"
                          Command="{Binding PreprocessCommand}" />
            </Menu>
        </DockPanel>

        <!-- ===================== Main three-pane layout ===================== -->
        <Grid ColumnDefinitions="240, 4, *, 4, 220">

            <!-- Left: toolbar + inspector -->
            <DockPanel Grid.Column="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">

                <!-- Toolbar -->
                <WrapPanel DockPanel.Dock="Top" Margin="4">
                    <ToggleButton Margin="2" Padding="8,6"
                                  ToolTip.Tip="{svc:Localize common.tool.pan}"
                                  IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Pan}"
                                  Command="{Binding SelectToolCommand}" CommandParameter="Pan">
                        <TextBlock Text="{svc:Localize common.tool.pan}" />
                    </ToggleButton>
                    <ToggleButton Margin="2" Padding="8,6"
                                  ToolTip.Tip="{svc:Localize common.tool.selector}"
                                  IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Selector}"
                                  Command="{Binding SelectToolCommand}" CommandParameter="Selector">
                        <TextBlock Text="{svc:Localize common.tool.selector}" />
                    </ToggleButton>
                    <ToggleButton Margin="2" Padding="8,6"
                                  ToolTip.Tip="{svc:Localize common.tool.rectangle}"
                                  IsChecked="{Binding CurrentTool, Mode=OneWay, Converter={StaticResource StringEquals}, ConverterParameter=Rectangle}"
                                  Command="{Binding SelectToolCommand}" CommandParameter="Rectangle">
                        <TextBlock Text="{svc:Localize common.tool.rectangle}" />
                    </ToggleButton>
                    <Button Margin="2" Padding="8,6"
                            ToolTip.Tip="{svc:Localize common.tool.delete}"
                            Command="{Binding DeleteSelectedCommand}">
                        <TextBlock Text="🗑" />
                    </Button>
                </WrapPanel>

                <!-- Inspector -->
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="0,1,0,0" Padding="10,6">
                    <TextBlock Text="{svc:Localize inspector.inspector}"
                               FontSize="11" FontWeight="Medium" />
                </Border>

                <ScrollViewer>
                    <!-- Empty state; annotation fields render here once the model is ported -->
                    <StackPanel Margin="12,32" Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="{svc:Localize inspector.noAnnotationSelMsg}"
                                   FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                        <TextBlock Text="{svc:Localize inspector.selectAnnotationMsg}"
                                   FontSize="11" Opacity="0.5" TextWrapping="Wrap" TextAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns"
                          Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

            <!-- Center: annotation canvas -->
            <Panel Grid.Column="2">
                <ctrl:AnnotationCanvas x:Name="Canvas" />
                <TextBlock Text="{svc:Localize scrollbar.uploadImage}"
                           IsVisible="{Binding ImageCount, Converter={StaticResource IntEquals}, ConverterParameter=0}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#AAAAAA" FontSize="13"
                           IsHitTestVisible="False" />
            </Panel>

            <GridSplitter Grid.Column="3" ResizeDirection="Columns"
                          Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

            <!-- Right: image list -->
            <DockPanel Grid.Column="4" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                <Border DockPanel.Dock="Top"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                        BorderThickness="0,0,0,1" Padding="10,6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{svc:Localize scrollbar.images}"
                                   FontSize="11" FontWeight="Medium" />
                        <TextBlock Text="{Binding ImageCount, StringFormat='({0})'}"
                                   FontSize="11" Opacity="0.7" />
                    </StackPanel>
                </Border>

                <!-- Empty state; image indicator list renders here once file loading is ported -->
                <StackPanel Margin="12,32" Spacing="6" HorizontalAlignment="Center"
                            IsVisible="{Binding ImageCount, Converter={StaticResource IntEquals}, ConverterParameter=0}">
                    <TextBlock Text="{svc:Localize scrollbar.noImage}"
                               FontSize="12" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="{svc:Localize scrollbar.uploadImage}"
                               FontSize="11" Opacity="0.5" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
